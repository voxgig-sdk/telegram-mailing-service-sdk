# Entity: mailing

main: kit: entity: mailing: {

  alias: field: {}

  fields: [
    {
      name: "attachments"
      req: false
      short: "Optional list of file URLs to attach"
      type: "`$ARRAY`"
    }
    {
      name: "completedAt"
      req: false
      short: "Timestamp when the mailing was completed"
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: false
      short: "Timestamp when the mailing was created"
      type: "`$STRING`"
    }
    {
      name: "failedCount"
      req: false
      short: "Number of messages that failed to send"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier of the mailing"
      type: "`$STRING`"
    }
    {
      name: "message"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Message content"
      type: "`$STRING`"
    }
    {
      name: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Name of the mailing campaign"
      type: "`$STRING`"
    }
    {
      name: "parseMode"
      req: false
      short: "Message formatting mode"
      type: "`$STRING`"
    }
    {
      name: "recipients"
      req: true
      short: "List of Telegram usernames or chat IDs"
      type: "`$ARRAY`"
    }
    {
      name: "scheduleTime"
      req: false
      short: "Scheduled time for the mailing"
      type: "`$STRING`"
    }
    {
      name: "sentCount"
      req: false
      short: "Number of messages successfully sent"
      type: "`$INTEGER`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the mailing"
      type: "`$STRING`"
    }
    {
      name: "totalRecipients"
      req: false
      short: "Total number of recipients"
      type: "`$INTEGER`"
    }
    {
      name: "updatedAt"
      req: false
      short: "Timestamp when the mailing was last updated"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "mailing"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/mailings"
          parts: [
            "mailings"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "status"
                orig: "status"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/mailings"
          parts: [
            "mailings"
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "status"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "mailing_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/mailings/{mailingId}"
          parts: [
            "mailings"
            "{id}"
          ]
          rename: {
            param: {
              mailingId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "mailing_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/mailings/{mailingId}"
          parts: [
            "mailings"
            "{id}"
          ]
          rename: {
            param: {
              mailingId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
